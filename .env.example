# Copy to .env and fill in. .env is gitignored — never commit real values.

# Modal (remote GPU training, see `uv run nanogpt-train`).
# Generate at https://modal.com/settings/tokens. Alternative to `modal token set`;
# both vars must be set together, or leave both unset to use `modal token set`.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
